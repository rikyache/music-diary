<Window x:Class="MusicDiary.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:h="clr-namespace:MusicDiary.Helpers" Style="{StaticResource {x:Type Window}}" Title="Личный музыкальный дневник" Width="1380" Height="900" MinWidth="1120" MinHeight="720" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="#1A1D21" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="18,28,18,22">
                <StackPanel DockPanel.Dock="Top" Margin="12,0,0,38">
                    <TextBlock Text="◉  ТИХАЯ СТОРОНА" Foreground="{StaticResource AccentBrush}" FontSize="14" FontWeight="Bold" />
                    <TextBlock Text="Личный музыкальный&#xA;дневник" FontSize="19" FontWeight="SemiBold" Margin="0,16,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="12,24,12,0">
                    <TextBlock Text="Ваша музыка.&#xA;Ваши впечатления." Foreground="{StaticResource MutedBrush}" FontSize="13" />
                    <TextBlock Text="ХРАНИТСЯ НА ЭТОМ УСТРОЙСТВЕ" FontSize="9" Foreground="#818791" Margin="0,14,0,0" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="ДНЕВНИК" Foreground="#818791" FontSize="10" Margin="16,0,0,12" />
                    <Button Content="⌂   Главная" Command="{Binding NavigateCommand}" CommandParameter="Главная">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Section}" Value="Главная">
                                        <Setter Property="Background" Value="#39312F" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="▤   Каталог" Command="{Binding NavigateCommand}" CommandParameter="Каталог">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Section}" Value="Каталог">
                                        <Setter Property="Background" Value="#39312F" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="♡   Избранное" Command="{Binding NavigateCommand}" CommandParameter="Избранное">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Section}" Value="Избранное">
                                        <Setter Property="Background" Value="#39312F" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="▥   Статистика" Command="{Binding NavigateCommand}" CommandParameter="Статистика">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Section}" Value="Статистика">
                                        <Setter Property="Background" Value="#39312F" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="84" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="32,0">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="＋  Добавить альбом" Command="{Binding AddAlbumCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Section}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                </DockPanel>
            </Border>
            <Border Grid.Row="1" Background="#3E302C" Margin="32,12,32,0" Padding="14" CornerRadius="6" Visibility="{Binding Message, Converter={StaticResource TextVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="×" Command="{Binding DismissMessageCommand}" Padding="8,2" Margin="12,0,0,0" />
                    <TextBlock Text="{Binding Message}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <ScrollViewer x:Name="PageScroll" Grid.Row="2" h:ScrollBehavior.ResetOnChange="{Binding CurrentPage}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,26,22,32">
                <ContentControl Content="{Binding CurrentPage}" HorizontalContentAlignment="Stretch" />
            </ScrollViewer>
            <Border Grid.Row="2" Background="{StaticResource BackgroundBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Открываем ваш дневник" FontSize="26" Margin="0,0,0,18" />
                    <Button Content="Повторить загрузку" Command="{Binding RetryCommand}" />
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.ColumnSpan="2" Background="#BB141619" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}">
            <TextBlock Text="Секунду, работаем с дневником…" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>