<UserControl x:Class="MusicDiary.Views.AlbumDetailsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="30" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <ContentControl Content="{Binding Album.CoverPath}" ContentTemplate="{StaticResource CoverTemplate}" Height="290" VerticalAlignment="Top" />
            <StackPanel Grid.Column="2">
                <TextBlock Text="ЗАПИСЬ В ДНЕВНИКЕ" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12" />
                <TextBlock Text="{Binding Album.Title}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Album.Artist}" FontSize="23" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18" />
                <TextBlock>
                    <Run Text="{Binding Album.ReleaseYear}" />
                    <Run Text="  ·  " />
                    <Run Text="{Binding Album.Genre}" />
                </TextBlock>
                <WrapPanel Margin="0,18,0,0">
                    <Border Background="#39312F" CornerRadius="5" Padding="12,7" Margin="0,0,10,8">
                        <TextBlock Text="{Binding Album.Rating, Converter={StaticResource RatingText}}" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <Border Background="{StaticResource InputBrush}" CornerRadius="5" Padding="12,7" Margin="0,0,0,8">
                        <TextBlock Text="{Binding Album.Status, Converter={StaticResource StatusText}}" />
                    </Border>
                </WrapPanel>
                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,15">
                    <Run Text="Последнее прослушивание: " />
                    <Run Text="{Binding Album.ListeningDate, StringFormat=dd.MM.yyyy, TargetNullValue=—}" />
                </TextBlock>
                <Button Content="{Binding FavoriteLabel}" Command="{Binding FavoriteCommand}" HorizontalAlignment="Left" />
            </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Content="Редактировать альбом" Command="{Binding EditCommand}" />
            <Button Content="Удалить" Command="{Binding DeleteCommand}" Foreground="#F0A8A0" Margin="12,0,0,0" />
        </StackPanel>
        <TextBlock Text="Впечатления" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource Panel}">
            <TextBlock Text="{Binding ReviewText}" FontSize="16" LineHeight="26" />
        </Border>
        <TextBlock Text="Треки" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="Названия, любимые моменты и заметки. После правок нажмите «Сохранить треки»." Style="{StaticResource Muted}" Margin="0,0,0,12" />
        <ItemsControl ItemsSource="{Binding Tracks}" ItemTemplate="{StaticResource TrackEditor}" />
        <StackPanel Orientation="Horizontal">
            <Button Content="＋  Добавить трек" Command="{Binding AddTrackCommand}" />
            <Button Content="Сохранить треки" Command="{Binding SaveTracksCommand}" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" />
        </StackPanel>
        <TextBlock Text="История прослушиваний" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource Panel}">
            <StackPanel>
                <TextBlock Text="Вернулись к альбому? Сохраните ещё одно прослушивание." Style="{StaticResource Muted}" Margin="0,0,0,16" />
                <StackPanel Orientation="Horizontal">
                    <DatePicker SelectedDate="{Binding NewListeningDate}" Width="190" AutomationProperties.Name="Дата повторного прослушивания" />
                    <Button Content="＋  Записать прослушивание" Command="{Binding AddListeningCommand}" Margin="12,0,0,0" />
                </StackPanel>
                <TextBlock Text="Прослушиваний пока нет." Style="{StaticResource Muted}" Margin="0,18,0,0" Visibility="{Binding NoHistory, Converter={StaticResource BoolVisibility}}" />
                <ItemsControl ItemsSource="{Binding History}" Margin="0,18,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Удалить запись" Padding="10,5" Command="{Binding DataContext.RemoveListeningCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                <TextBlock Text="{Binding ListenedAt, StringFormat=dd MMMM yyyy}" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>