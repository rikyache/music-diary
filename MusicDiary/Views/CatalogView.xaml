<UserControl x:Class="MusicDiary.Views.CatalogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="0,0,0,24" />
        <Border Style="{StaticResource Panel}" Padding="20,6,20,20">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Название альбома" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding TitleSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Поиск по названию" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Исполнитель" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ArtistSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Поиск по исполнителю" />
                    </StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Жанр" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Genres}" SelectedItem="{Binding SelectedGenre}" AutomationProperties.Name="Фильтр жанра" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,14,0">
                        <TextBlock Text="Статус" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Statuses}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedStatus}" AutomationProperties.Name="Фильтр статуса" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Оценка" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Ratings}" SelectedItem="{Binding SelectedRating}" AutomationProperties.Name="Фильтр оценки" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
        <DockPanel Margin="0,20,0,20">
            <ComboBox DockPanel.Dock="Right" Width="230" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" AutomationProperties.Name="Сортировка" />
            <Button DockPanel.Dock="Right" Content="Сбросить" Command="{Binding ResetCommand}" Margin="0,0,12,0" />
            <TextBlock Text="{Binding ResultText}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
        </DockPanel>
        <Border Style="{StaticResource Panel}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}">
            <StackPanel>
                <TextBlock Text="Здесь пока тихо" FontSize="24" />
                <TextBlock Text="Добавьте альбом, отметьте его как любимый или измените условия поиска." Style="{StaticResource Muted}" Margin="0,10,0,0" />
            </StackPanel>
        </Border>
        <ItemsControl ItemsSource="{Binding Albums}" ItemTemplate="{StaticResource AlbumCard}" ItemsPanel="{StaticResource CardsPanel}" />
    </StackPanel>
</UserControl>