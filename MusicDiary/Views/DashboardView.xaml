<UserControl x:Class="MusicDiary.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Слушать. Чувствовать. Запоминать." Style="{StaticResource PageTitle}" />
        <TextBlock Text="Маленький архив больших музыкальных впечатлений." Style="{StaticResource Muted}" Margin="0,0,0,26" />
        <UniformGrid Columns="3">
            <Border Style="{StaticResource Panel}" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="{Binding ListenedCount}" FontSize="36" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="альбомов прослушано" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Panel}" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="{Binding AverageRating}" FontSize="36" />
                    <TextBlock Text="средняя оценка · из 10" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="{Binding FavoriteCount}" FontSize="36" />
                    <TextBlock Text="любимых альбомов" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>
        <Border Style="{StaticResource Panel}" Margin="0,24,0,0" Padding="32" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}">
            <StackPanel>
                <TextBlock Text="У каждой коллекции есть первая пластинка" FontSize="24" />
                <TextBlock Text="Добавьте альбом, который сейчас звучит в наушниках, или сохраните музыку на потом." Style="{StaticResource Muted}" Margin="0,12,0,22" />
                <Button Content="＋  Добавить первый альбом" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Command="{Binding DataContext.AddAlbumCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
        </Border>
        <TextBlock Text="Последние добавленные" Style="{StaticResource SectionTitle}" />
        <ItemsControl ItemsSource="{Binding RecentAlbums}" ItemTemplate="{StaticResource AlbumCard}" ItemsPanel="{StaticResource CardsPanel}" />
        <TextBlock Text="Недавно звучало" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="Здесь появятся альбомы с датой прослушивания." Style="{StaticResource Muted}" Visibility="{Binding NoListening, Converter={StaticResource BoolVisibility}}" />
        <ItemsControl ItemsSource="{Binding RecentlyListened}" ItemTemplate="{StaticResource AlbumCard}" ItemsPanel="{StaticResource CardsPanel}" />
    </StackPanel>
</UserControl>